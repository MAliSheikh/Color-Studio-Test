# Go to https://console.groq.com/keys for api key
# ── Groq API Key ───────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Database ────────────────────────────────────────────────────────────────────
# Task 3 scraper uses this:
DATABASE_URL=

# Task 4 review app uses its own SQLite by default (task4_reviews.db).
# To share one PostgreSQL DB (Task 1 schema), uncomment and fill in below:
# TASK4_DATABASE_URL=postgresql://user:password@localhost:5432/colorstudio

# ── Task 4 — FastAPI server ─────────────────────────────────────────────────────
PORT=8000

# ── Task 4 — Shopify App credentials ───────────────────────────────────────────
# Get these from: https://partners.shopify.com → Apps → [Your App] → API credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
